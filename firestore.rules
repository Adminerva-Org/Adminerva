rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    // Temporary development instructor allowlist. Replace with teacher claims/roles.
    function isInstructor() {
      return signedIn() &&
        (request.auth.token.email.lower() == "babaynike2013@gmail.com" ||
         request.auth.token.email.lower() == "josephsixson@mcstayuman.edu.ph");
    }
    function ownsStudentProfile(studentId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.email.lower() ==
          request.auth.token.email.lower();
    }

    match /{document=**} {
      allow read, write: if isInstructor();
    }

    match /students/{studentId} {
      allow read: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower();
      // Do not permit students to change identity, section, or role information.
      // githubToken remains writable for compatibility with the existing OAuth flow;
      // migrate that token to a secure backend in a later release.
      allow update: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["githubUsername", "repoUrl", "githubToken", "gender"]);
      allow create, delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower();
    }

    match /student_grades/{gradeId} {
      // Student queries must constrain BOTH studentId and published == true.
      // Do not infer privacy from frontend-only published checks.
      allow read: if signedIn() &&
        resource.data.published == true &&
        resource.data.studentId is string &&
        ownsStudentProfile(resource.data.studentId);
    }

    match /student_dashboard_cache/{studentId} {
      allow read, write: if ownsStudentProfile(studentId);
    }

    match /assessments/{assessmentPath=**} {
      allow read: if signedIn();
      // TODO: split hidden rubrics and AI instructions into instructor-only documents.
    }

    match /playground_snapshots/{snapshotId} {
      // New snapshots are private unless explicitly shared by link.
      // Legacy public-by-link records remain compatible until migration.
      allow read: if signedIn() &&
        (resource.data.get("visibility","legacy") == "legacy" ||
         resource.data.get("visibility","") == "link" ||
         resource.data.get("ownerUid","") == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.visibility in ["private","link"] &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list;
      allow update, delete: if false;
    }

    // Recoverable cloud code is visible only to the authenticated owner;
    // revisions are immutable to prevent accidental multi-device overwrites.
    match /student_playground_workspaces/{uid}/versions/{versionId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.ownerUid == uid &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list &&
        request.resource.data.lang in ["java","python","web","csharp","cpp","dart"];
      allow update, delete: if false;
    }

    // Reports are visible to signed-in users for duplicate discovery.
    // Only trusted instructors may triage, prioritize, lock or delete reports.
    match /issues/{issueId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "title", "description", "category", "priority", "images",
          "urlContext", "reporterEmail", "reporterUid", "reporterRole",
          "status", "upvotes", "locked", "createdAt",
          "module", "expectedBehavior", "actualBehavior", "reproductionSteps",
          "clientContext"
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reporterEmail is string &&
        (request.resource.data.reporterEmail == "" ||
         request.resource.data.reporterEmail.lower() == request.auth.token.email.lower()) &&
        request.resource.data.reporterRole == "reporter" &&
        request.resource.data.category in ["Bug", "Access", "Feature", "UI", "Other"] &&
        request.resource.data.priority in ["Low", "Medium", "High", "Critical"] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 4 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 5 &&
        request.resource.data.description.size() <= 6000 &&
        request.resource.data.images is list &&
        request.resource.data.images.size() <= 5 &&
        request.resource.data.status == "Open" &&
        request.resource.data.locked == false &&
        request.resource.data.upvotes.size() == 0 &&
        request.resource.data.createdAt == request.time;
      // New votes use Firebase UID; legacy email votes can still be removed.
      // Only adding/removing the authenticated user's single vote is allowed.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["upvotes"]) &&
        request.resource.data.upvotes is list &&
        request.resource.data.upvotes.size() <= 500 &&
        (
          (
            !(request.auth.uid in resource.data.upvotes) &&
            request.auth.uid in request.resource.data.upvotes &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() + 1 &&
            request.resource.data.upvotes.hasAll(resource.data.upvotes)
          ) ||
          (
            request.auth.uid in resource.data.upvotes &&
            !(request.auth.uid in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          ) ||
          (
            request.auth.token.email.lower() in resource.data.upvotes &&
            !(request.auth.token.email.lower() in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          )
        );
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly([
            "text", "authorEmail", "authorUid", "role", "createdAt"
          ]) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorEmail is string &&
          (request.resource.data.authorEmail == "" ||
           request.resource.data.authorEmail.lower() == request.auth.token.email.lower()) &&
          request.resource.data.role == "student" &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/issues/$(issueId)).data.locked == false;
        allow update: if false;
        allow delete: if signedIn() &&
          (resource.data.get("authorUid", null) == request.auth.uid ||
           (resource.data.get("authorEmail", "") is string &&
            resource.data.authorEmail != "" &&
            resource.data.authorEmail.lower() == request.auth.token.email.lower()));
      }
    }

    // Official notifications are created only by Firebase Admin SDK triggers.
    // Recipients may mark their own notification as read, not forge an alert.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]) &&
        request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    // Only instructors may read or write internal grading-failure diagnostics.
    match /grading_alerts/{alertId} {
      allow read, write: if isInstructor();
    }

    // Student-initiated submission receipts are immutable, reviewable evidence.
    match /student_submissions/{submissionId} {
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "studentId", "assessmentId", "submittedByUid",
          "studentName", "assessmentTitle", "repoUrl", "githubLogin",
          "revisionSha", "sourcePath", "submittedAt", "section"
        ]) &&
        request.resource.data.submittedByUid == request.auth.uid &&
        ownsStudentProfile(request.resource.data.studentId) &&
        request.resource.data.studentId is string &&
        request.resource.data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)) &&
        request.resource.data.section is string &&
        request.resource.data.section ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.sourcePath is string &&
        request.resource.data.sourcePath.size() <= 240 &&
        request.resource.data.repoUrl is string &&
        request.resource.data.repoUrl.matches("^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$") &&
        request.resource.data.revisionSha is string &&
        request.resource.data.revisionSha.matches("^[a-fA-F0-9]{40}$") &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
  }
}
