rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    // Verified Firebase Auth identity, never the browser's simulated role.
    // Migrate this temporary email mapping to Firebase custom claims later.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == "babaynike2013@gmail.com";
    }
    function isTeacher() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == "josephsixson@mcstayuman.edu.ph";
    }
    function isInstructor() {
      return isAdmin() || isTeacher();
    }
    function mayReadIssue(issue) {
      return signedIn() && (
        isAdmin() ||
        (isTeacher() && issue.get("audience", "admin") == "teacher") ||
        issue.get("reporterUid", "") == request.auth.uid ||
        (issue.get("reporterEmail", "") is string &&
         issue.get("reporterEmail", "") != "" &&
         issue.get("reporterEmail", "").lower() == request.auth.token.email.lower())
      );
    }
    function mayReadIssueById(issueId) {
      return exists(/databases/$(database)/documents/issues/$(issueId)) &&
        mayReadIssue(get(/databases/$(database)/documents/issues/$(issueId)).data);
    }
    function ownsStudentProfile(studentId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.email.lower() ==
          request.auth.token.email.lower();
    }

    // Administrators retain existing system-wide maintenance privileges.
    match /{collection}/{document=**} {
      allow read, write: if isAdmin() && collection != "assessment_evidence" && collection != "student_grades";
    }
    // Teachers retain their existing academic workflow permissions, but the
    // catch-all must not override private report or notification rules.
    match /{collection}/{document=**} {
      allow read, write: if isTeacher() &&
        collection != "issues" &&
        collection != "notifications" &&
        collection != "notification_history" &&
        collection != "commit_reclaims" &&
        collection != "commit_claim_decisions" &&
        collection != "commit_claim_conflicts" &&
        collection != "assessment_evidence" &&
        collection != "student_grades";
    }

    match /students/{studentId} {
      allow read: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower();
      // Do not permit students to change identity, section, or role information.
      // githubToken remains writable for compatibility with the existing OAuth flow;
      // migrate that token to a secure backend in a later release.
      allow update: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["githubUsername", "repoUrl", "githubToken", "gender"]);
      allow create, delete: if false;
    }

    match /teachers/{teacherId} {
      allow read: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower();
    }

    match /student_grades/{gradeId} {
      function v2Grade(data) {
        let taskId = data.get("taskId", "");
        return taskId is string && taskId != "" &&
          exists(/databases/$(database)/documents/assessments/$(taskId)) &&
          get(/databases/$(database)/documents/assessments/$(taskId)).data.get("schemaVersion",1) == 2;
      }
      function currentEvidence(data) {
        let evidence = getAfter(/databases/$(database)/documents/assessment_evidence/$(gradeId)).data;
        return evidence.status == "approved" && data.studentId == evidence.studentId &&
          data.taskId == evidence.assessmentId && data.gradedSha == evidence.approvedCheckpointSha &&
          data.evidenceRevision == evidence.get("revision",0) &&
          data.manuallyAdjusted == true && data.reviewRequired == false &&
          data.reviewedBy is string && data.teacherReviewNote is string &&
          data.teacherReviewNote.size() > 0 && data.score is number && data.maxScore is number &&
          data.maxScore == get(/databases/$(database)/documents/assessments/$(data.taskId)).data.maxScore &&
          data.score >= 0 && data.score <= data.maxScore;
      }
      allow read: if isInstructor();
      allow create: if isInstructor() && (!v2Grade(request.resource.data) ||
        (request.resource.data.published == false && currentEvidence(request.resource.data)));
      allow update: if isInstructor() && (
        (!v2Grade(resource.data) && !v2Grade(request.resource.data)) ||
        (request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.taskId == resource.data.taskId &&
         ((resource.data.published == true && request.resource.data.published == false &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["published"])) ||
          (resource.data.published == false && currentEvidence(request.resource.data) &&
           (request.resource.data.published == false ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["published"]))))));
      allow delete: if isInstructor() && !v2Grade(resource.data);
      // Student queries must constrain BOTH studentId and published == true.
      // Do not infer privacy from frontend-only published checks.
      allow read: if signedIn() &&
        resource.data.published == true &&
        resource.data.studentId is string &&
        ownsStudentProfile(resource.data.studentId);
    }


    // V2 assessment evidence is student-proposed until reviewed by staff.
    // Firestore cannot authenticate Git commits or prove push time. Never
    // interpret a student-written SHA as verified authorship or a final grade.
    function shaAt(commits,offset) {
      return commits.size() <= offset ||
        (commits[offset] is string && commits[offset].matches("^[a-fA-F0-9]{40}$"));
    }
    function validEvidenceCommits(commits) {
      return commits is list && commits.size() > 0 && commits.size() <= 20 &&
        commits.toSet().size() == commits.size() &&
        shaAt(commits,0) && shaAt(commits,1) && shaAt(commits,2) && shaAt(commits,3) &&
        shaAt(commits,4) && shaAt(commits,5) && shaAt(commits,6) && shaAt(commits,7) &&
        shaAt(commits,8) && shaAt(commits,9) && shaAt(commits,10) && shaAt(commits,11) &&
        shaAt(commits,12) && shaAt(commits,13) && shaAt(commits,14) && shaAt(commits,15) &&
        shaAt(commits,16) && shaAt(commits,17) && shaAt(commits,18) && shaAt(commits,19);
    }
    function ownV2Evidence(data) {
      return signedIn() &&
        data.studentId is string && ownsStudentProfile(data.studentId) &&
        data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(data.assessmentId)) &&
        get(/databases/$(database)/documents/assessments/$(data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        data.section == get(/databases/$(database)/documents/students/$(data.studentId)).data.section &&
        data.repository == get(/databases/$(database)/documents/students/$(data.studentId)).data.repoUrl &&
        data.repository is string && data.repository.size() <= 300 &&
        validEvidenceCommits(data.selectedCommits) &&
        data.checkpointSha is string &&
        data.checkpointSha.matches("^[a-fA-F0-9]{40}$") &&
        data.selectedCommits.hasAny([data.checkpointSha]) &&
        data.status in ["submitted","withdrawn"];
    }

    function evidenceAudit(evidenceId) {
      let version = request.resource.data.revision;
      let audit = getAfter(/databases/$(database)/documents/assessment_evidence/$(evidenceId)/revisions/$(string(version))).data;
      return version is int && version == resource.data.get("revision",0) + 1 &&
        audit.before == resource.data && audit.after == request.resource.data &&
        audit.actorUid == request.auth.uid && audit.createdAt == request.time &&
        audit.reason is string && audit.reason.size() >= 10 && audit.reason.size() <= 3000 &&
        request.resource.data.updatedAt == request.time;
    }

    function instructorEvidenceChange(evidenceId) {
      let before = resource.data;
      let after = request.resource.data;
      return isInstructor() && evidenceAudit(evidenceId) && (
        (before.status in ["submitted","needs_review"] && after.status == "approved" &&
         after.approvedCheckpointSha == before.checkpointSha && after.reviewedBy == request.auth.uid &&
         after.reviewedAt == request.time && after.verificationNote is string &&
         after.verificationNote.size() >= 15 && after.verificationNote.size() <= 3000 &&
         after.contributionScope is string && after.contributionScope.size() >= 15 &&
         after.contributionScope.size() <= 3000 && after.verifiedContributionCommits is list &&
         after.verifiedContributionCommits.hasOnly(before.selectedCommits) &&
         after.diff(before).affectedKeys().hasOnly(["status","approvedCheckpointSha","reviewedBy",
           "reviewedAt","verificationNote","contributionScope","verifiedContributionCommits","revision","updatedAt"])) ||
        (before.status == "approved" && after.status == "reopened" &&
         (!exists(/databases/$(database)/documents/student_grades/$(evidenceId)) ||
          get(/databases/$(database)/documents/student_grades/$(evidenceId)).data.published == false) &&
         after.approvedCheckpointSha == null && after.verifiedContributionCommits == [] &&
         after.contributionScope == "" && after.reopenedBy == request.auth.uid &&
         after.reopenedAt == request.time && after.reopenReason is string &&
         after.reopenReason.size() >= 15 && after.reopenReason.size() <= 3000 &&
         after.diff(before).affectedKeys().hasOnly(["status","approvedCheckpointSha","verifiedContributionCommits",
           "contributionScope","reopenedBy","reopenedAt","reopenReason","revision","updatedAt"])));
    }

    match /assessment_evidence/{evidenceId} {
      allow read: if isInstructor();
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId);
      allow create: if ownV2Evidence(request.resource.data) &&
        request.resource.data.keys().hasOnly(["studentId","assessmentId","section","repository",
          "selectedCommits","checkpointSha","status","submittedAt","updatedAt"]) &&
        request.resource.data.status == "submitted" &&
        evidenceId == request.resource.data.studentId + "_" + request.resource.data.assessmentId &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if ownV2Evidence(request.resource.data) &&
        (resource.data.status == "reopened" ||
          (resource.data.status in ["submitted","withdrawn"] &&
            (resource.data.get("source","") != "teacher_discovered" || resource.data.get("reopenedBy",null) is string))) &&
        evidenceAudit(evidenceId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.assessmentId == resource.data.assessmentId &&
        (request.resource.data.status == "submitted" ? request.resource.data.submittedAt == request.time :
          request.resource.data.get("submittedAt",null) == resource.data.get("submittedAt",null)) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["selectedCommits","checkpointSha","status","submittedAt","updatedAt","revision"]);
      allow update: if instructorEvidenceChange(evidenceId);
      allow create: if isInstructor() && request.resource.data.keys().hasOnly([
        "studentId","assessmentId","section","repository","selectedCommits","checkpointSha",
        "status","source","discoveredBy","recordedAt","updatedAt"]) &&
        evidenceId == request.resource.data.studentId + "_" + request.resource.data.assessmentId &&
        request.resource.data.status == "needs_review" && request.resource.data.source == "teacher_discovered" &&
        request.resource.data.discoveredBy == request.auth.uid && request.resource.data.recordedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        request.resource.data.repository == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.repoUrl &&
        request.resource.data.section == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.checkpointSha.matches("^[a-fA-F0-9]{40}$") &&
        validEvidenceCommits(request.resource.data.selectedCommits) &&
        request.resource.data.selectedCommits.hasAny([request.resource.data.checkpointSha]);
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if isInstructor() || ownsStudentProfile(get(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data.studentId);
        allow create: if signedIn() && request.resource.data.keys().hasOnly(["before","after","actorUid","reason","createdAt"]) &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.before == get(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data &&
          revisionId == string(request.resource.data.after.revision) &&
          request.resource.data.after.revision == request.resource.data.before.get("revision",0) + 1;
        allow update, delete: if false;
      }
    }

    // A reclaim is an unverified attribution request, not a transfer of
    // authorship. Only staff can accept/reject it; students may withdraw.
    match /commit_reclaims/{claimId} {
      allow read: if isInstructor() ||
        (signedIn() && ownsStudentProfile(resource.data.studentId));
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["studentId","assessmentId","section",
          "repository","sha","detectedAuthorName","detectedAuthorLogin",
          "explanation","status","createdAt"]) &&
        request.resource.data.studentId is string &&
        ownsStudentProfile(request.resource.data.studentId) &&
        request.resource.data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)) &&
        get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        request.resource.data.section ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.repository ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.repoUrl &&
        request.resource.data.repository is string &&
        request.resource.data.repository.size() <= 300 &&
        request.resource.data.sha is string &&
        request.resource.data.sha.matches("^[a-fA-F0-9]{40}$") &&
        claimId == request.resource.data.sha + "_" + request.resource.data.studentId &&
        request.resource.data.explanation is string &&
        request.resource.data.explanation.size() >= 10 &&
        request.resource.data.explanation.size() <= 1500 &&
        request.resource.data.detectedAuthorName is string &&
        request.resource.data.detectedAuthorName.size() <= 120 &&
        request.resource.data.detectedAuthorLogin is string &&
        request.resource.data.detectedAuthorLogin.size() <= 80 &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdAt == request.time;
      allow update: if signedIn() && ownsStudentProfile(resource.data.studentId) &&
        resource.data.status == "pending" &&
        request.resource.data.status == "withdrawn" &&
        request.resource.data.withdrawnAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status","withdrawnAt"]);
      allow delete: if false;
    }

    // Staff review provenance. Decisions are administrator-controlled for now.
    match /commit_claim_decisions/{decisionId} {
      allow read: if isInstructor();
      allow write: if isAdmin();
    }
    match /commit_claim_conflicts/{conflictId} {
      allow read: if isInstructor();
      allow write: if false; // Cloud Functions Admin SDK only.
    }

    match /student_dashboard_cache/{studentId} {
      allow read, write: if ownsStudentProfile(studentId);
    }

    match /assessments/{assessmentPath=**} {
      allow read: if signedIn();
      // TODO: split hidden rubrics and AI instructions into instructor-only documents.
    }

    match /playground_snapshots/{snapshotId} {
      // New snapshots are private unless explicitly shared by link.
      // Legacy public-by-link records remain compatible until migration.
      allow read: if signedIn() &&
        (resource.data.get("visibility","legacy") == "legacy" ||
         resource.data.get("visibility","") == "link" ||
         resource.data.get("ownerUid","") == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.visibility in ["private","link"] &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list;
      allow update, delete: if false;
    }

    // Recoverable cloud code is visible only to the authenticated owner;
    // revisions are immutable to prevent accidental multi-device overwrites.
    match /student_playground_workspaces/{uid}/versions/{versionId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.ownerUid == uid &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list &&
        request.resource.data.lang in ["java","python","web","csharp","cpp","dart"];
      allow update, delete: if false;
    }

    // Reports are private to their reporter and selected staff audience.
    // Bug reports are ALWAYS admin-only (plus reporter access to My reports).
    // Missing audience on legacy records means admin until migrated.
    match /issues/{issueId} {
      allow read: if mayReadIssue(resource.data);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "title", "description", "category", "priority", "images",
          "urlContext", "reporterEmail", "reporterUid", "reporterRole",
          "status", "upvotes", "locked", "createdAt",
          "module", "expectedBehavior", "actualBehavior", "reproductionSteps",
          "clientContext", "audience"
        ]) &&
        request.resource.data.audience in ["teacher", "admin"] &&
        (request.resource.data.category != "Bug" ||
         request.resource.data.audience == "admin") &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reporterEmail is string &&
        (request.resource.data.reporterEmail == "" ||
         request.resource.data.reporterEmail.lower() == request.auth.token.email.lower()) &&
        request.resource.data.reporterRole == "reporter" &&
        request.resource.data.category in ["Bug", "Access", "Feature", "UI", "Other"] &&
        request.resource.data.priority in ["Low", "Medium", "High", "Critical"] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 4 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 5 &&
        request.resource.data.description.size() <= 6000 &&
        request.resource.data.images is list &&
        request.resource.data.images.size() <= 5 &&
        request.resource.data.status == "Open" &&
        request.resource.data.locked == false &&
        request.resource.data.upvotes.size() == 0 &&
        request.resource.data.createdAt == request.time;
      // New votes use Firebase UID; legacy email votes can still be removed.
      // Only adding/removing the authenticated user's single vote is allowed.
      allow update: if (isTeacher() &&
        resource.data.get("audience", "admin") == "teacher" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "priority", "locked", "updatedAt"]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"]) ||
          request.resource.data.updatedAt == request.time
        )) ||
        (mayReadIssue(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["upvotes"]) &&
        request.resource.data.upvotes is list &&
        request.resource.data.upvotes.size() <= 500 &&
        (
          (
            !(request.auth.uid in resource.data.upvotes) &&
            request.auth.uid in request.resource.data.upvotes &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() + 1 &&
            request.resource.data.upvotes.hasAll(resource.data.upvotes)
          ) ||
          (
            request.auth.uid in resource.data.upvotes &&
            !(request.auth.uid in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          ) ||
          (
            request.auth.token.email.lower() in resource.data.upvotes &&
            !(request.auth.token.email.lower() in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          )
        ));
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if mayReadIssueById(issueId);
        allow create: if mayReadIssueById(issueId) &&
          request.resource.data.keys().hasOnly([
            "text", "authorEmail", "authorUid", "role", "createdAt"
          ]) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorEmail is string &&
          (request.resource.data.authorEmail == "" ||
           request.resource.data.authorEmail.lower() == request.auth.token.email.lower()) &&
          request.resource.data.role == "student" &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/issues/$(issueId)).data.locked == false;
        allow update: if false;
        allow delete: if mayReadIssueById(issueId) &&
          (resource.data.get("authorUid", null) == request.auth.uid ||
           (resource.data.get("authorEmail", "") is string &&
            resource.data.authorEmail != "" &&
            resource.data.authorEmail.lower() == request.auth.token.email.lower()));
      }
    }

    // Official notifications are created only by Firebase Admin SDK triggers.
    // Recipients may mark their own notification as read, not forge an alert.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]) &&
        request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    // Formative student practice, separate from official assessments/grades.
    // Teachers may inspect progress through the existing instructor privileges.
    match /student_practice_progress/{uid}/courses/{courseId} {
      function validProgress() {
        return request.resource.data.keys().hasOnly([
          "ownerUid", "courseId", "completed", "reflections", "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "ownerUid", "courseId", "completed", "reflections", "updatedAt"
        ]) &&
        request.resource.data.ownerUid == uid &&
        request.resource.data.courseId == courseId &&
        courseId in ["java","python","web","logic"] &&
        request.resource.data.completed is list &&
        request.resource.data.completed.size() <= 40 &&
        request.resource.data.reflections is map &&
        request.resource.data.reflections.size() <= 40 &&
        request.resource.data.updatedAt == request.time;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        validProgress();
      allow delete: if false;
    }

    // Personal read history and saved reminders. Students can retain a small
    // notification summary for later; other users cannot inspect this inbox.
    match /notification_history/{uid}/items/{notificationId} {
      function validHistory() {
        return request.resource.data.keys().hasOnly([
            "ownerUid", "sourceKey", "type", "title", "body", "target",
            "at", "savedForLater", "openedAt", "lastInteractedAt",
            "reportCategory", "reportAudience"
          ]) &&
          request.resource.data.keys().hasAll([
            "ownerUid", "sourceKey", "type", "title", "body", "target",
            "at", "savedForLater", "openedAt", "lastInteractedAt"
          ]) &&
          request.resource.data.ownerUid == uid &&
          request.resource.data.sourceKey is string &&
          request.resource.data.sourceKey.size() <= 500 &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 240 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 800 &&
          request.resource.data.type is string &&
          request.resource.data.type.size() <= 32 &&
          request.resource.data.target is string &&
          request.resource.data.target.size() <= 220 &&
          request.resource.data.at is number &&
          request.resource.data.savedForLater is bool &&
          request.resource.data.openedAt == request.time &&
          request.resource.data.lastInteractedAt == request.time;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validHistory();
      allow update: if signedIn() && request.auth.uid == uid &&
        resource.data.ownerUid == uid &&
        resource.data.sourceKey == request.resource.data.sourceKey &&
        validHistory();
      allow delete: if false;
    }

    // Only instructors may read or write internal grading-failure diagnostics.
    match /grading_alerts/{alertId} {
      allow read, write: if isInstructor();
    }

    // Student-initiated submission receipts are immutable, reviewable evidence.
    match /student_submissions/{submissionId} {
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "studentId", "assessmentId", "submittedByUid",
          "studentName", "assessmentTitle", "repoUrl", "githubLogin",
          "revisionSha", "sourcePath", "submittedAt", "section"
        ]) &&
        request.resource.data.submittedByUid == request.auth.uid &&
        ownsStudentProfile(request.resource.data.studentId) &&
        request.resource.data.studentId is string &&
        request.resource.data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)) &&
        request.resource.data.section is string &&
        request.resource.data.section ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.sourcePath is string &&
        request.resource.data.sourcePath.size() <= 240 &&
        request.resource.data.repoUrl is string &&
        request.resource.data.repoUrl.matches("^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$") &&
        request.resource.data.revisionSha is string &&
        request.resource.data.revisionSha.matches("^[a-fA-F0-9]{40}$") &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
  }
}
