rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    // Verified Firebase Auth identity, never the browser's simulated role.
    // Migrate this temporary email mapping to Firebase custom claims later.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email.lower() == "babaynike2013@gmail.com";
    }
    function isTeacher() {
      let email = signedIn() ? request.auth.token.email.lower() : "";
      let path = /databases/$(database)/documents/staff_access/$(email);
      return signedIn() && request.auth.token.email_verified == true &&
        (exists(path) ? (get(path).data.role == "teacher" && get(path).data.status == "active" && get(path).data.email == email)
          : email == "josephsixson@mcstayuman.edu.ph");
    }
    function isInstructor() {
      return isAdmin() || isTeacher();
    }
    function teacherSections() {
      let path = /databases/$(database)/documents/staff_access/$(request.auth.token.email.lower());
      return exists(path) ? get(path).data.get("sections",[]) : [];
    }
    function mayTeachSection(section) {
      return isAdmin() || (isTeacher() && section is string && section in teacherSections());
    }
    function mayTeachStudent(studentId) {
      return isAdmin() || (isTeacher() && studentId is string &&
        mayTeachSection(get(/databases/$(database)/documents/students/$(studentId)).data.section));
    }
    function mayTeachAssessment(assessmentId) {
      let data = get(/databases/$(database)/documents/assessments/$(assessmentId)).data;
      return isAdmin() || (isTeacher() && (data.get("ownerUid","") == request.auth.uid || data.get("sectionIds",[]).hasAny(teacherSections())));
    }
    function mayGrade(data) {
      return isAdmin() || (isTeacher() && data.section in teacherSections() &&
        data.section == get(/databases/$(database)/documents/students/$(data.studentId)).data.section &&
        data.section in get(/databases/$(database)/documents/assessments/$(data.taskId)).data.get("sectionIds",[]));
    }
    function serverOwned(name) {
      return name in ["academic_access_preparations","teaching_roster","student_access","practice_sessions","practice_browser_sessions","practice_attempts","practice_awards","practice_verified_progress","practice_class_progress","practice_security_events","system_private","school_ai_results","school_ai_usage","practice_public_rankings","practice_season_scores","practice_season_progress","practice_season_awards","practice_season_attempts","practice_class_season_rankings"];
    }
    function monitoringCollection(name) {
      return name in ["activity_preferences", "activity_events", "issue_diagnostics", "analytics_rosters", "analytics_views", "monitoring_control", "monitoring_status"];
    }
    function personalCollection(name) {
      return name in ["staff_access","staff_workspaces","lesson_plans","presentations","app_config","global_settings","teachers","grade_revisions","commit_claim_decisions","commit_claim_conflicts","account_requests","school_catalog"];
    }
    // School credentials, usage counters and cached AI responses never reach web clients.
    match /system_private/{record=**} { allow read, write: if false; }
    match /school_ai_results/{record=**} { allow read, write: if false; }
    match /school_ai_usage/{record=**} { allow read, write: if false; }
    // Public visibility is explicit opt-in. Only backend handlers may publish scores.
    match /practice_public_rankings/{recordId} { allow read: if true; allow write: if false; }
    match /practice_season_scores/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
      match /mission_state/{missionId} { allow read, write: if false; }
    }
    match /practice_season_progress/{uid}/courses/{courseId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /practice_season_awards/{uid}/missions/{missionId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /practice_season_attempts/{attemptId} { allow read, write: if false; }
    match /practice_class_season_rankings/{studentId} {
      allow read: if mayTeachSection(resource.data.section);
      allow write: if false;
    }
    match /staff_access/{email} {
      function validStaff() {
        let data = request.resource.data;
        let prior = resource == null ? null : resource.data;
        let audit = getAfter(/databases/$(database)/documents/staff_access/$(email)/revisions/$(string(data.revision))).data;
        return data.keys().hasOnly(["email","displayName","role","status","revision","reason","updatedBy","updatedAt","sections","subjects"]) &&
          data.email == email && email == email.lower() && email.matches("^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$") && email.size() <= 254 &&
          email != "babaynike2013@gmail.com" && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
          data.role == "teacher" && data.status in ["active","disabled"] && data.get("sections",[]) is list && data.get("sections",[]).size() <= 40 &&
          data.get("subjects",[]) is list && data.get("subjects",[]).size() <= 40 && data.revision is int &&
          data.revision == (prior == null ? 1 : prior.revision + 1) && data.reason is string && data.reason.size() >= 12 && data.reason.size() <= 600 &&
          data.updatedBy == request.auth.uid && data.updatedAt == request.time &&
          audit.before == prior && audit.after == data && audit.actorUid == request.auth.uid && audit.createdAt == request.time;
      }
      allow get: if isAdmin() || (signedIn() && request.auth.token.email_verified == true && email == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validStaff();
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(["before","after","actorUid","createdAt"]) &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/staff_access/$(email)).data &&
          revision == string(request.resource.data.after.revision) && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.before == (exists(/databases/$(database)/documents/staff_access/$(email)) ? get(/databases/$(database)/documents/staff_access/$(email)).data : null);
        allow update, delete: if false;
      }
    }
    match /staff_workspaces/{ownerUid}/{kind}/{recordId} {
      function personalOwner() { return isInstructor() && request.auth.uid == ownerUid; }
      function validPersonal() {
        let data = request.resource.data;
        return data.keys().size() <= 35 &&
          (kind == "preferences" || (data.ownerUid == ownerUid && data.version is int && data.version > 0 &&
            ((kind == "schedules" && data.json_data is string && data.json_data.size() <= 200000 && data.raw_text is string && data.raw_text.size() <= 100000) ||
             (kind == "lesson_plans" && data.sessions is list && data.sessions.size() <= 12 && data.weekly_overview is map && data.subject_title is string && data.subject_title.size() <= 300) ||
             (kind == "presentations" && data.deck is list && data.deck.size() <= 200))));
      }
      function validPersonalUpdate() {
        let audit = kind == "preferences" ? null : getAfter(/databases/$(database)/documents/staff_workspaces/$(ownerUid)/$(kind)/$(recordId)/revisions/$(string(resource.data.version))).data;
        return kind == "preferences" || (request.resource.data.ownerUid == resource.data.ownerUid &&
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["is_archived","archived_at","purge_at"]) ||
           (request.resource.data.version == resource.data.version + 1 && audit.archivedRevisionAt == request.time &&
            audit.diff(resource.data).affectedKeys().hasOnly(["archivedRevisionAt"]))));
      }
      allow read: if kind in ["lesson_plans","presentations","schedules","preferences"] && (personalOwner() || isAdmin());
      allow create: if personalOwner() && validPersonal() && (kind == "preferences" || request.resource.data.version == 1);
      allow update: if personalOwner() && validPersonal() && validPersonalUpdate();
      allow delete: if personalOwner() && kind in ["lesson_plans","presentations"] && resource.data.get("is_archived",false) == true;
      match /revisions/{revision} {
        allow read: if personalOwner() || isAdmin();
        allow create: if personalOwner() && kind in ["lesson_plans","presentations","schedules"] &&
          request.resource.data.diff(get(/databases/$(database)/documents/staff_workspaces/$(ownerUid)/$(kind)/$(recordId)).data).affectedKeys().hasOnly(["archivedRevisionAt"]) &&
          request.resource.data.archivedRevisionAt == request.time &&
          revision == string(request.resource.data.version) &&
          getAfter(/databases/$(database)/documents/staff_workspaces/$(ownerUid)/$(kind)/$(recordId)).data.version == request.resource.data.version + 1;
        allow update, delete: if false;
      }
    }
    match /lesson_plans/{record=**} { allow read: if isAdmin(); }
    match /presentations/{record=**} { allow read: if isAdmin(); }
    match /app_config/{recordId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && !recordId.matches("^master_schedule.*");
    }
    match /global_settings/{recordId} {
      allow read: if isAdmin();
      allow write: if isAdmin() && recordId != "lesson_review_config";
    }
    match /reference_folders/{folderId}/documents/{documentId} {
      allow read, write: if isAdmin();
    }
    match /teacher_materials/{ownerUid}/{kind}/{recordId} {
      allow read: if isAdmin() || (isTeacher() && request.auth.uid == ownerUid);
      allow create, update: if isTeacher() && request.auth.uid == ownerUid && kind in ["repobank","group_repo_cache","github_stats_cache","system","templates","reference_folders"] && request.resource.data.keys().size() <= 50;
      allow delete: if isTeacher() && request.auth.uid == ownerUid;
      match /documents/{documentId} {
        allow read: if isAdmin() || (isTeacher() && request.auth.uid == ownerUid);
        allow write: if isTeacher() && request.auth.uid == ownerUid && kind == "reference_folders";
      }
    }
    match /teaching_roster/{studentId} {
      allow read: if mayTeachSection(resource.data.section);
      allow write: if false;
    }
    match /academic_access_preparations/{runId}/changes/{changeId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    function activityPages() {
      return ["home", "project", "assessments", "playground", "xml-lab", "practice", "review", "grades", "lessons", "slides", "analytics", "reports", "settings", "other"];
    }
    function activityActions() {
      return ["page-open", "active-time", "help-open", "run", "save", "evaluate", "submit", "withdraw"];
    }
    function monitoringExpiry(data) {
      return data.createdAt == request.time && data.expiresAt is timestamp &&
        data.expiresAt >= request.time + duration.value(29, "d") &&
        data.expiresAt <= request.time + duration.value(31, "d");
    }
    function mayReadIssue(issue) {
      return signedIn() && (
        isAdmin() ||
        (isTeacher() && issue.get("audience", "admin") == "teacher" && mayTeachSection(issue.get("section",null))) ||
        issue.get("reporterUid", "") == request.auth.uid ||
        (issue.get("reporterEmail", "") is string &&
         issue.get("reporterEmail", "") != "" &&
         issue.get("reporterEmail", "").lower() == request.auth.token.email.lower())
      );
    }
    function mayReadIssueById(issueId) {
      return exists(/databases/$(database)/documents/issues/$(issueId)) &&
        mayReadIssue(get(/databases/$(database)/documents/issues/$(issueId)).data);
    }
    function ownsStudentProfile(studentId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/students/$(studentId)) &&
        get(/databases/$(database)/documents/students/$(studentId)).data.email.lower() ==
          request.auth.token.email.lower() &&
        get(/databases/$(database)/documents/students/$(studentId)).data.get("status","active") == "active";
    }
    function mayReadStudentAssessment(data) {
      let path=/databases/$(database)/documents/student_access/$(request.auth.uid);
      let sections=exists(path)?get(path).data.get("sections",[]):[];
      return signedIn() && !isInstructor() && exists(path) &&
        (data.get("sectionIds",[]).hasAny(sections) || data.get("targetSections",[]).hasAny(sections));
    }

    // Administrators retain existing system-wide maintenance privileges.
    match /{collection}/{document} {
      allow read, write: if isAdmin() && !serverOwned(collection) && !monitoringCollection(collection) && !personalCollection(collection) && collection != "assessment_evidence" && collection != "student_grades" && collection != "assessments" && collection != "assessment_private" &&
        !(collection in ["practice_profiles","practice_scores","practice_boards","practice_rankings"]);
    }

    match /student_access/{ownerUid} {
      allow get: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /account_requests/{ownerUid} {
      function validRequest(data) {
        return data.keys().hasOnly(["ownerUid","email","displayName","requestedRole","status","revision","createdAt","updatedAt","approvedRole","studentId","reason","decidedBy"]) &&
          data.ownerUid == ownerUid && data.email is string && data.email.size() <= 254 &&
          data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
          data.requestedRole in ["guest","student","teacher"] && data.status in ["pending","approved","rejected"] &&
          data.revision is int && data.createdAt is timestamp && data.updatedAt == request.time;
      }
      function decisionMatches(data) {
        return data.status == "rejected" ? data.approvedRole == null && data.studentId == null :
          (data.status == "approved" && ((data.approvedRole == "teacher" && data.studentId == null &&
            getAfter(/databases/$(database)/documents/staff_access/$(data.email)).data.status == "active" &&
            getAfter(/databases/$(database)/documents/staff_access/$(data.email)).data.role == "teacher") ||
           (data.approvedRole == "student" && data.studentId is string &&
            getAfter(/databases/$(database)/documents/students/$(data.studentId)).data.email.lower() == data.email)));
      }
      function auditedDecision() {
        let data = request.resource.data;
        let audit = getAfter(/databases/$(database)/documents/account_requests/$(ownerUid)/revisions/$(string(data.revision))).data;
        return data.revision == resource.data.revision + 1 && resource.data.status == "pending" &&
          data.decidedBy == request.auth.uid && data.reason is string && data.reason.size() >= 12 && data.reason.size() <= 600 &&
          data.diff(resource.data).affectedKeys().hasOnly(["status","revision","approvedRole","studentId","reason","decidedBy","updatedAt"]) &&
          audit.before == resource.data && audit.after == data && audit.actorUid == request.auth.uid && audit.createdAt == request.time && decisionMatches(data);
      }
      allow get: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.token.email_verified == true && request.auth.uid == ownerUid &&
        validRequest(request.resource.data) && request.resource.data.email == request.auth.token.email.lower() &&
        request.resource.data.status == "pending" && request.resource.data.revision == 0 && request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly(["ownerUid","email","displayName","requestedRole","status","revision","createdAt","updatedAt"]);
      allow update: if validRequest(request.resource.data) &&
        ((signedIn() && request.auth.token.email_verified == true && request.auth.uid == ownerUid &&
          resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["displayName","requestedRole","updatedAt"])) ||
         (isAdmin() && auditedDecision()));
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(["before","after","actorUid","createdAt"]) &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.before == get(/databases/$(database)/documents/account_requests/$(ownerUid)).data &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/account_requests/$(ownerUid)).data &&
          revision == string(request.resource.data.after.revision) && request.resource.data.after.revision == request.resource.data.before.revision + 1;
        allow update, delete: if false;
      }
    }
    match /school_catalog/{kind}/records/{recordId} {
      function validCatalog(data) {
        return kind in ["sections","subjects","programs"] && data.keys().hasOnly(["name","scheme","type","notes","status","revision","updatedBy","updatedAt","gradeLevel","schoolYear","programId"]) &&
          data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
          data.scheme in ["legacy-shs","strengthened-shs","school-defined"] && data.type is string && data.type.size() <= 40 &&
          data.notes is string && data.notes.size() <= 1000 && data.status in ["active","archived"] &&
          data.get("gradeLevel","") is string && data.get("gradeLevel","").size() <= 30 &&
          data.get("schoolYear","") is string && data.get("schoolYear","").size() <= 20 &&
          data.get("programId","") is string && data.get("programId","").size() <= 150 &&
          data.updatedBy == request.auth.uid && data.updatedAt == request.time && data.revision is int;
      }
      function catalogAudit() {
        let data = request.resource.data;
        let before = exists(/databases/$(database)/documents/school_catalog/$(kind)/records/$(recordId)) ? resource.data : null;
        let audit = getAfter(/databases/$(database)/documents/school_catalog/$(kind)/records/$(recordId)/revisions/$(string(data.revision))).data;
        return data.revision == (before == null ? 1 : before.revision + 1) && audit.before == before && audit.after == data &&
          audit.actorUid == request.auth.uid && audit.createdAt == request.time;
      }
      allow read: if isInstructor();
      allow create, update: if isAdmin() && validCatalog(request.resource.data) && catalogAudit();
      allow delete: if false;
      match /revisions/{revision} {
        allow read: if isAdmin();
        allow create: if isAdmin() && request.resource.data.keys().hasOnly(["before","after","actorUid","createdAt"]) &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/school_catalog/$(kind)/records/$(recordId)).data &&
          request.resource.data.before == (exists(/databases/$(database)/documents/school_catalog/$(kind)/records/$(recordId)) ? get(/databases/$(database)/documents/school_catalog/$(kind)/records/$(recordId)).data : null) &&
          revision == string(request.resource.data.after.revision) &&
          request.resource.data.after.revision == (request.resource.data.before == null ? 1 : request.resource.data.before.revision + 1);
        allow update, delete: if false;
      }
    }
    // Monitoring is opt-in, append-only, bounded and separate from academic permissions.
    match /activity_preferences/{ownerUid} {
      function validPreference() {
        return request.resource.data.keys().hasOnly(["ownerUid", "studentId", "enabled", "promptDismissed", "updatedAt"]) &&
          request.resource.data.ownerUid == ownerUid && request.resource.data.enabled is bool &&
          request.resource.data.get("promptDismissed", false) is bool &&
          request.resource.data.updatedAt == request.time && request.resource.data.studentId is string &&
          ((isInstructor() && request.resource.data.studentId == "") || ownsStudentProfile(request.resource.data.studentId));
      }
      allow get: if signedIn() && (request.auth.uid == ownerUid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.token.email_verified == true &&
        request.auth.uid == ownerUid && validPreference();
      allow delete: if isAdmin();
    }
    match /activity_events/{eventId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(["ownerUid", "studentId", "sessionId", "page", "action", "activeSeconds", "createdAt", "expiresAt"]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        get(/databases/$(database)/documents/activity_preferences/$(request.auth.uid)).data.enabled == true &&
        request.resource.data.studentId == get(/databases/$(database)/documents/activity_preferences/$(request.auth.uid)).data.studentId &&
        ((isInstructor() && request.resource.data.studentId == "") || ownsStudentProfile(request.resource.data.studentId)) &&
        request.resource.data.sessionId is string && request.resource.data.sessionId.matches("^[a-f0-9-]{36}$") &&
        request.resource.data.page in activityPages() && request.resource.data.action in activityActions() &&
        request.resource.data.activeSeconds is int && request.resource.data.activeSeconds >= 0 && request.resource.data.activeSeconds <= 60 &&
        (request.resource.data.action == "active-time" || request.resource.data.activeSeconds == 0) && monitoringExpiry(request.resource.data);
      allow update: if false;
    }
    match /issue_diagnostics/{issueId} {
      allow read, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.keys().hasOnly(["ownerUid", "pages", "actions", "createdAt", "expiresAt"]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/issues/$(issueId)).data.reporterUid == request.auth.uid &&
        getAfter(/databases/$(database)/documents/issues/$(issueId)).data.audience == "admin" &&
        request.resource.data.pages is list && request.resource.data.actions is list &&
        request.resource.data.pages.size() > 0 && request.resource.data.pages.size() <= 20 &&
        request.resource.data.pages.size() == request.resource.data.actions.size() &&
        request.resource.data.pages.hasOnly(activityPages()) && request.resource.data.actions.hasOnly(activityActions()) &&
        monitoringExpiry(request.resource.data);
      allow update: if false;
    }
    match /analytics_rosters/{teacherEmail} {
      allow get: if isAdmin() || (isTeacher() && teacherEmail == request.auth.token.email.lower());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && teacherEmail.matches("^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$") &&
        request.resource.data.keys().hasOnly(["teacherEmail", "sections", "subjects", "updatedBy", "updatedAt"]) &&
        request.resource.data.teacherEmail == teacherEmail && request.resource.data.sections is list && request.resource.data.sections.size() <= 40 &&
        request.resource.data.get("subjects",[]) is list && request.resource.data.get("subjects",[]).size() <= 40 &&
        request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /analytics_views/{teacherEmail} {
      allow get: if isAdmin() || (isTeacher() && teacherEmail == request.auth.token.email.lower() &&
        (!exists(/databases/$(database)/documents/analytics_views/$(teacherEmail)) ||
          (resource.data.sections == get(/databases/$(database)/documents/analytics_rosters/$(teacherEmail)).data.sections && resource.data.sections.hasOnly(teacherSections()) &&
           resource.data.publishedAt >= request.time - duration.value(30, "d"))));
      allow list: if isAdmin();
      allow create, update: if isAdmin() && teacherEmail.matches("^[^/@ ]+@[^/@ ]+\\.[^/@ ]+$") &&
        request.resource.data.keys().hasOnly(["teacherEmail", "rows", "sections", "windowDays", "eventLimit", "publishedBy", "publishedAt"]) &&
        request.resource.data.teacherEmail == teacherEmail && request.resource.data.rows is list && request.resource.data.rows.size() <= 100 &&
        request.resource.data.sections == get(/databases/$(database)/documents/analytics_rosters/$(teacherEmail)).data.sections &&
        request.resource.data.windowDays == 7 && request.resource.data.eventLimit == 500 &&
        request.resource.data.publishedBy == request.auth.uid && request.resource.data.publishedAt == request.time;
      allow delete: if isAdmin();
    }
    match /monitoring_control/{controlId} {
      function auditedControl() {
        let data = request.resource.data;
        let priorRevision = resource == null ? 0 : resource.data.revision;
        let audit = getAfter(/databases/$(database)/documents/monitoring_control/runtime/revisions/$(string(data.revision))).data;
        return controlId == "runtime" && data.keys().hasOnly(["cleanupEnabled", "summaryRefreshEnabled", "revision", "updatedBy", "updatedAt", "reason"]) &&
          data.cleanupEnabled is bool && data.summaryRefreshEnabled is bool && data.revision is int && data.revision == priorRevision + 1 &&
          data.updatedBy == request.auth.uid && data.updatedAt == request.time && data.reason is string && data.reason.size() >= 12 && data.reason.size() <= 600 &&
          audit.after == data && audit.before == (resource == null ? null : resource.data) && audit.actorUid == request.auth.uid && audit.reason == data.reason && audit.createdAt == request.time;
      }
      allow get: if isAdmin();
      allow create, update: if isAdmin() && auditedControl();
      allow delete, list: if false;
      match /revisions/{revisionId} {
        allow read: if isAdmin();
        allow create: if isAdmin() && controlId == "runtime" &&
          request.resource.data.keys().hasOnly(["before", "after", "actorUid", "reason", "createdAt"]) &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/monitoring_control/runtime).data &&
          request.resource.data.before == (exists(/databases/$(database)/documents/monitoring_control/runtime) ? get(/databases/$(database)/documents/monitoring_control/runtime).data : null) &&
          revisionId == string(request.resource.data.after.revision) && request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.reason == request.resource.data.after.reason && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /monitoring_status/{statusId} {
      allow get: if isAdmin() && statusId == "runtime";
      allow list, create, update, delete: if false;
    }
    match /students/{studentId} {
      allow read: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower();
      // Do not permit students to change identity, section, or role information.
      // githubToken remains writable for compatibility with the existing OAuth flow;
      // migrate that token to a secure backend in a later release.
      allow update: if signedIn() && resource.data.email is string &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        resource.data.get("status","active") == "active" &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["githubUsername", "repoUrl", "githubToken", "gender"]);
      allow create, delete: if false;
    }

    match /teachers/{teacherId} {
      function ownTeacher() { return signedIn() && request.auth.token.email_verified == true && resource.data.email.lower() == request.auth.token.email.lower(); }
      function validTeacherConnection() {
        let data=request.resource.data;
        return data.get("githubToken","") is string && data.get("githubToken","").size() <= 1000 &&
          data.get("githubUsername","") is string && data.get("githubUsername","").size() <= 100 &&
          data.get("geminiKey","") is string && data.get("geminiKey","").size() <= 1000 &&
          data.get("aiModel","") is string && data.get("aiModel","").size() <= 120 &&
          data.get("engineMode","") is string && data.get("engineMode","").size() <= 40 &&
          data.get("name","") is string && data.get("name","").size() <= 120;
      }
      allow read: if isAdmin() || ownTeacher();
      allow create: if isAdmin() || (isTeacher() && teacherId == request.auth.uid &&
        request.resource.data.keys().hasOnly(["email","name","uid","githubToken","githubUsername","geminiKey","aiModel","engineMode"]) &&
        request.resource.data.email == request.auth.token.email.lower() && request.resource.data.uid == request.auth.uid &&
        validTeacherConnection());
      allow update: if isAdmin() || (isTeacher() && ownTeacher() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["githubToken","githubUsername","name","geminiKey","aiModel","engineMode"]) &&
        validTeacherConnection());
      allow delete: if isAdmin();
    }

    match /student_grades/{gradeId} {
      allow get: if isInstructor() && !exists(/databases/$(database)/documents/student_grades/$(gradeId));
      function v2Grade(data) {
        let taskId = data.get("taskId", "");
        return taskId is string && taskId != "" &&
          exists(/databases/$(database)/documents/assessments/$(taskId)) &&
          get(/databases/$(database)/documents/assessments/$(taskId)).data.get("schemaVersion",1) == 2;
      }
      function currentEvidence(data) {
        let evidence = getAfter(/databases/$(database)/documents/assessment_evidence/$(gradeId)).data;
        return evidence.status == "approved" && data.studentId == evidence.studentId &&
          data.taskId == evidence.assessmentId && data.gradedSha == evidence.approvedCheckpointSha &&
          data.evidenceRevision == evidence.get("revision",0) &&
          data.manuallyAdjusted == true && data.reviewRequired == false &&
          data.reviewedBy is string && data.teacherReviewNote is string &&
          data.teacherReviewNote.size() > 0 && data.score is number && data.maxScore is number &&
          data.maxScore == get(/databases/$(database)/documents/assessments/$(data.taskId)).data.maxScore &&
          data.score >= 0 && data.score <= data.maxScore;
      }
      allow read: if mayTeachSection(resource.data.get("section",null));
      allow create: if mayGrade(request.resource.data) && (!v2Grade(request.resource.data) ||
        (request.resource.data.published == false && currentEvidence(request.resource.data)));
      allow update: if mayGrade(request.resource.data) &&
        request.resource.data.studentId == resource.data.studentId && request.resource.data.taskId == resource.data.taskId &&
        request.resource.data.section == resource.data.section && (
        (!v2Grade(resource.data) && !v2Grade(request.resource.data)) ||
        (request.resource.data.studentId == resource.data.studentId &&
         request.resource.data.taskId == resource.data.taskId &&
         ((resource.data.published == true && request.resource.data.published == false &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(["published"])) ||
          (resource.data.published == false && currentEvidence(request.resource.data) &&
           (request.resource.data.published == false ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["published"]))))));
      allow delete: if mayGrade(resource.data) && !v2Grade(resource.data);
      // Student queries must constrain BOTH studentId and published == true.
      // Do not infer privacy from frontend-only published checks.
      allow read: if signedIn() &&
        resource.data.published == true &&
        resource.data.studentId is string &&
        ownsStudentProfile(resource.data.studentId);
    }

    match /grade_revisions/{revisionId} {
      function matchingRevision() {
        let data = request.resource.data;
        let path = /databases/$(database)/documents/student_grades/$(data.gradeId);
        let before = exists(path) ? get(path).data : null;
        let after = getAfter(path).data;
        return data.keys().hasOnly(["gradeId","studentId","taskId","editorUid","reason","before","after","createdAt"]) &&
          data.gradeId is string && data.gradeId.size() <= 500 && data.gradeId.matches("^[^/]+$") &&
          data.studentId == after.studentId && data.taskId == after.taskId &&
          data.editorUid == request.auth.uid && data.createdAt == request.time &&
          data.reason is string && data.reason.size() >= 10 && data.reason.size() <= 3100 &&
          (data.before == null ? before == null : (before != null && data.before is map &&
            data.before.get("score",before.get("score",null)) == before.get("score",null) &&
            data.before.get("feedback",before.get("feedback",null)) == before.get("feedback",null) &&
            data.before.get("published",before.get("published",false)) == before.get("published",false))) &&
          data.after is map && data.after.keys().hasAny(["score","feedback","published"]) &&
          (before == null || after != before) &&
          data.after.get("score",after.get("score",null)) == after.get("score",null) &&
          data.after.get("feedback",after.get("feedback",null)) == after.get("feedback",null) &&
          data.after.get("published",after.get("published",false)) == after.get("published",false);
      }
      allow read: if mayTeachStudent(resource.data.studentId);
      allow create: if mayTeachStudent(request.resource.data.studentId) && mayTeachAssessment(request.resource.data.taskId) && matchingRevision();
      allow update, delete: if false;
    }


    // V2 assessment evidence is student-proposed until reviewed by staff.
    // Firestore cannot authenticate Git commits or prove push time. Never
    // interpret a student-written SHA as verified authorship or a final grade.
    function shaAt(commits,offset) {
      return commits.size() <= offset ||
        (commits[offset] is string && commits[offset].matches("^[a-fA-F0-9]{40}$"));
    }
    function validEvidenceCommits(commits) {
      return commits is list && commits.size() > 0 && commits.size() <= 20 &&
        commits.toSet().size() == commits.size() &&
        shaAt(commits,0) && shaAt(commits,1) && shaAt(commits,2) && shaAt(commits,3) &&
        shaAt(commits,4) && shaAt(commits,5) && shaAt(commits,6) && shaAt(commits,7) &&
        shaAt(commits,8) && shaAt(commits,9) && shaAt(commits,10) && shaAt(commits,11) &&
        shaAt(commits,12) && shaAt(commits,13) && shaAt(commits,14) && shaAt(commits,15) &&
        shaAt(commits,16) && shaAt(commits,17) && shaAt(commits,18) && shaAt(commits,19);
    }
    function ownV2Evidence(data) {
      return signedIn() &&
        data.studentId is string && ownsStudentProfile(data.studentId) &&
        data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(data.assessmentId)) &&
        get(/databases/$(database)/documents/assessments/$(data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        data.section == get(/databases/$(database)/documents/students/$(data.studentId)).data.section &&
        data.repository == get(/databases/$(database)/documents/students/$(data.studentId)).data.repoUrl &&
        data.repository is string && data.repository.size() <= 300 &&
        validEvidenceCommits(data.selectedCommits) &&
        data.checkpointSha is string &&
        data.checkpointSha.matches("^[a-fA-F0-9]{40}$") &&
        data.status in ["submitted","withdrawn"];
    }

    function evidenceAudit(evidenceId) {
      let version = request.resource.data.revision;
      let audit = getAfter(/databases/$(database)/documents/assessment_evidence/$(evidenceId)/revisions/$(string(version))).data;
      return version is int && version == resource.data.get("revision",0) + 1 &&
        audit.before == resource.data && audit.after == request.resource.data &&
        audit.actorUid == request.auth.uid && audit.createdAt == request.time &&
        audit.reason is string && audit.reason.size() >= 10 && audit.reason.size() <= 3000 &&
        request.resource.data.updatedAt == request.time;
    }

    function instructorEvidenceChange(evidenceId) {
      let before = resource.data;
      let after = request.resource.data;
      return mayTeachStudent(before.studentId) && mayTeachAssessment(before.assessmentId) && evidenceAudit(evidenceId) && (
        (before.status in ["submitted","needs_review","approved"] && after.status == "approved" &&
         (before.status != "approved" ||
          !exists(/databases/$(database)/documents/student_grades/$(evidenceId)) ||
          get(/databases/$(database)/documents/student_grades/$(evidenceId)).data.published == false) &&
         after.approvedCheckpointSha == before.checkpointSha && after.reviewedBy == request.auth.uid &&
         after.reviewedAt == request.time && after.verificationNote is string &&
         after.verificationNote.size() >= 15 && after.verificationNote.size() <= 3000 &&
         after.contributionScope is string && after.contributionScope.size() >= 15 &&
         after.contributionScope.size() <= 3000 && after.verifiedContributionCommits is list &&
         after.verifiedContributionCommits.size() <= 20 &&
         after.verifiedContributionCommits.hasOnly(before.selectedCommits) &&
         after.diff(before).affectedKeys().hasOnly(["status","approvedCheckpointSha","reviewedBy",
           "reviewedAt","verificationNote","contributionScope","verifiedContributionCommits","revision","updatedAt"])) ||
        (before.status in ["submitted","approved","needs_review"] && after.status == "reopened" &&
         (!exists(/databases/$(database)/documents/student_grades/$(evidenceId)) ||
          get(/databases/$(database)/documents/student_grades/$(evidenceId)).data.published == false) &&
         after.approvedCheckpointSha == null && after.verifiedContributionCommits == [] &&
         after.contributionScope == "" && after.reopenedBy == request.auth.uid &&
         after.reopenedAt == request.time && after.reopenReason is string &&
         after.reopenReason.size() >= 15 && after.reopenReason.size() <= 3000 &&
         after.diff(before).affectedKeys().hasOnly(["status","approvedCheckpointSha","verifiedContributionCommits",
           "contributionScope","reopenedBy","reopenedAt","reopenReason","revision","updatedAt"])));
    }

    match /assessment_evidence/{evidenceId} {
      allow get: if isInstructor() && !exists(/databases/$(database)/documents/assessment_evidence/$(evidenceId));
      allow read: if mayTeachSection(resource.data.section);
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId);
      allow create: if ownV2Evidence(request.resource.data) &&
        request.resource.data.keys().hasOnly(["studentId","assessmentId","section","repository",
          "selectedCommits","checkpointSha","status","submittedAt","updatedAt"]) &&
        request.resource.data.status == "submitted" &&
        evidenceId == request.resource.data.studentId + "_" + request.resource.data.assessmentId &&
        request.resource.data.submittedAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if ownV2Evidence(request.resource.data) &&
        (resource.data.status == "reopened" ||
          (resource.data.status in ["submitted","withdrawn"] &&
            (resource.data.get("source","") != "teacher_discovered" || resource.data.get("reopenedBy",null) is string))) &&
        evidenceAudit(evidenceId) &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.assessmentId == resource.data.assessmentId &&
        (request.resource.data.status == "submitted" ? request.resource.data.submittedAt == request.time :
          request.resource.data.get("submittedAt",null) == resource.data.get("submittedAt",null)) &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["selectedCommits","checkpointSha","status","submittedAt","updatedAt","revision"]);
      allow update: if instructorEvidenceChange(evidenceId);
      allow create: if mayTeachStudent(request.resource.data.studentId) && mayTeachAssessment(request.resource.data.assessmentId) && request.resource.data.keys().hasOnly([
        "studentId","assessmentId","section","repository","selectedCommits","checkpointSha",
        "status","source","discoveredBy","recordedAt","updatedAt"]) &&
        evidenceId == request.resource.data.studentId + "_" + request.resource.data.assessmentId &&
        request.resource.data.status == "needs_review" && request.resource.data.source == "teacher_discovered" &&
        request.resource.data.discoveredBy == request.auth.uid && request.resource.data.recordedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        request.resource.data.repository == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.repoUrl &&
        request.resource.data.section == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.checkpointSha.matches("^[a-fA-F0-9]{40}$") &&
        validEvidenceCommits(request.resource.data.selectedCommits);
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if mayTeachStudent(get(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data.studentId) || ownsStudentProfile(get(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data.studentId);
        allow create: if signedIn() && request.resource.data.keys().hasOnly(["before","after","actorUid","reason","createdAt"]) &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.before == get(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/assessment_evidence/$(evidenceId)).data &&
          revisionId == string(request.resource.data.after.revision) &&
          request.resource.data.after.revision == request.resource.data.before.get("revision",0) + 1;
        allow update, delete: if false;
      }
    }

    // A reclaim is an unverified attribution request, not a transfer of
    // authorship. Only staff can accept/reject it; students may withdraw.
    match /commit_reclaims/{claimId} {
      allow read: if mayTeachSection(resource.data.section) ||
        (signedIn() && ownsStudentProfile(resource.data.studentId));
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["studentId","assessmentId","section",
          "repository","sha","detectedAuthorName","detectedAuthorLogin",
          "explanation","status","createdAt"]) &&
        request.resource.data.studentId is string &&
        ownsStudentProfile(request.resource.data.studentId) &&
        request.resource.data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)) &&
        get(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)).data.get("schemaVersion",1) == 2 &&
        request.resource.data.section ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.repository ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.repoUrl &&
        request.resource.data.repository is string &&
        request.resource.data.repository.size() <= 300 &&
        request.resource.data.sha is string &&
        request.resource.data.sha.matches("^[a-fA-F0-9]{40}$") &&
        claimId == request.resource.data.sha + "_" + request.resource.data.studentId &&
        request.resource.data.explanation is string &&
        request.resource.data.explanation.size() >= 10 &&
        request.resource.data.explanation.size() <= 1500 &&
        request.resource.data.detectedAuthorName is string &&
        request.resource.data.detectedAuthorName.size() <= 120 &&
        request.resource.data.detectedAuthorLogin is string &&
        request.resource.data.detectedAuthorLogin.size() <= 80 &&
        request.resource.data.status == "pending" &&
        request.resource.data.createdAt == request.time;
      allow update: if signedIn() && ownsStudentProfile(resource.data.studentId) &&
        resource.data.status == "pending" &&
        request.resource.data.status == "withdrawn" &&
        request.resource.data.withdrawnAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status","withdrawnAt"]);
      allow delete: if false;
    }

    // Staff review provenance. Decisions are administrator-controlled for now.
    match /commit_claim_decisions/{decisionId} {
      allow read: if isAdmin() || mayTeachStudent(resource.data.get("studentId",""));
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /commit_claim_conflicts/{conflictId} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions Admin SDK only.
    }

    match /student_dashboard_cache/{studentId} {
      allow read, write: if ownsStudentProfile(studentId);
    }

    match /practice_packs/{packId} {
      function validPracticePack(data) {
        return data.keys().hasOnly(["id","ownerUid","title","sectionIds","missionRefs","notes","dueDate","status","createdAt","updatedAt"]) &&
          data.id == packId && data.ownerUid is string && data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
          data.sectionIds is list && data.sectionIds.size() > 0 && data.sectionIds.size() <= 20 &&
          data.missionRefs is list && data.missionRefs.size() > 0 && data.missionRefs.size() <= 80 &&
          data.notes is string && data.notes.size() <= 3000 && data.dueDate is string && data.dueDate.size() <= 20 &&
          data.status in ["active","archived"] && data.updatedAt == request.time;
      }
      allow read: if isAdmin() || (isTeacher() && resource.data.sectionIds.hasAny(teacherSections())) ||
        (signedIn() && !isInstructor() && resource.data.sectionIds.hasAny(get(/databases/$(database)/documents/student_access/$(request.auth.uid)).data.get("sections",[])));
      allow create: if isInstructor() && validPracticePack(request.resource.data) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.sectionIds.hasOnly(isAdmin()?request.resource.data.sectionIds:teacherSections()) && request.resource.data.createdAt == request.time;
      allow update: if isInstructor() && resource.data.ownerUid == request.auth.uid && validPracticePack(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /student_projects/{projectId} {
      function validStudentProject(data) {
        return data.keys().hasOnly(["id","ownerUid","title","sectionIds","studentIds","description","dueDate","status","createdAt","updatedAt"]) &&
          data.id == projectId && data.ownerUid is string && data.title is string && data.title.size() > 0 && data.title.size() <= 160 &&
          data.sectionIds is list && data.sectionIds.size() > 0 && data.sectionIds.size() <= 20 &&
          data.studentIds is list && data.studentIds.size() <= 80 && data.description is string && data.description.size() <= 4000 &&
          data.dueDate is string && data.dueDate.size() <= 20 && data.status in ["active","archived"] && data.updatedAt == request.time;
      }
      allow read: if isAdmin() || (isTeacher() && resource.data.sectionIds.hasAny(teacherSections())) ||
        (signedIn() && !isInstructor() && (resource.data.sectionIds.hasAny(get(/databases/$(database)/documents/student_access/$(request.auth.uid)).data.get("sections",[])) ||
          resource.data.studentIds.hasAny(get(/databases/$(database)/documents/student_access/$(request.auth.uid)).data.get("studentIds",[]))));
      allow create: if isInstructor() && validStudentProject(request.resource.data) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.sectionIds.hasOnly(isAdmin()?request.resource.data.sectionIds:teacherSections()) && request.resource.data.createdAt == request.time;
      allow update: if isInstructor() && resource.data.ownerUid == request.auth.uid && validStudentProject(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
    match /improvement_plans/{studentId}/items/{planId} {
      function validImprovementPlan(data) {
        return data.keys().hasOnly(["id","studentId","section","ownerUid","title","skills","goal","nextAction","packId","status","createdAt","updatedAt"]) &&
          data.id == planId && data.studentId == studentId && data.section is string && data.ownerUid is string &&
          data.title is string && data.title.size() <= 160 && data.skills is list && data.skills.size() <= 12 &&
          data.goal is string && data.goal.size() > 0 && data.goal.size() <= 3000 &&
          data.nextAction is string && data.nextAction.size() > 0 && data.nextAction.size() <= 3000 &&
          data.packId is string && data.packId.size() <= 120 && data.status in ["active","completed","closed"] && data.updatedAt == request.time;
      }
      allow read: if mayTeachStudent(studentId) || ownsStudentProfile(studentId);
      allow create: if mayTeachStudent(studentId) && validImprovementPlan(request.resource.data) && request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.section == get(/databases/$(database)/documents/students/$(studentId)).data.section && request.resource.data.createdAt == request.time;
      allow update: if mayTeachStudent(studentId) && resource.data.ownerUid == request.auth.uid && validImprovementPlan(request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /teacher_evaluation_drafts/{ownerUid}/items/{draftId} {
      function validDraft() {
        let data=request.resource.data;
        return isInstructor() && request.auth.uid == ownerUid &&
          data.keys().hasOnly(["ownerUid","studentId","taskId","section","evidenceRevision","checkpointSha","model","draft","createdAt","status"]) &&
          data.ownerUid == ownerUid && data.studentId is string && data.taskId is string &&
          mayTeachStudent(data.studentId) && mayTeachAssessment(data.taskId) &&
          data.section is string && data.evidenceRevision is int && data.evidenceRevision >= 0 &&
          data.checkpointSha is string && data.checkpointSha.matches("^[a-fA-F0-9]{40}$") &&
          data.model is string && data.model.size() <= 120 && data.draft is map &&
          data.status == "private_suggestion" && data.createdAt == request.time;
      }
      allow read: if isInstructor() && request.auth.uid == ownerUid;
      allow create: if validDraft();
      allow update: if false;
      allow delete: if isInstructor() && request.auth.uid == ownerUid;
    }

    match /assessments/{assessmentId} {
      function validAssessment(data) {
        return data.get("ownerUid","") is string && data.get("sectionIds",[]) is list && data.sectionIds.size() <= 20 &&
          data.get("deployments",[]) is list && data.deployments.size() <= 20 &&
          data.get("targetSections",[]) is list && data.get("targetSections",[]).hasOnly(data.sectionIds) &&
          (data.deployments.size() <= 0 || data.deployments[0].section in data.sectionIds) &&
          (data.deployments.size() <= 1 || data.deployments[1].section in data.sectionIds) &&
          (data.deployments.size() <= 2 || data.deployments[2].section in data.sectionIds) &&
          (data.deployments.size() <= 3 || data.deployments[3].section in data.sectionIds) &&
          (data.deployments.size() <= 4 || data.deployments[4].section in data.sectionIds) &&
          (data.deployments.size() <= 5 || data.deployments[5].section in data.sectionIds) &&
          (data.deployments.size() <= 6 || data.deployments[6].section in data.sectionIds) &&
          (data.deployments.size() <= 7 || data.deployments[7].section in data.sectionIds) &&
          (data.deployments.size() <= 8 || data.deployments[8].section in data.sectionIds) &&
          (data.deployments.size() <= 9 || data.deployments[9].section in data.sectionIds) &&
          (data.deployments.size() <= 10 || data.deployments[10].section in data.sectionIds) &&
          (data.deployments.size() <= 11 || data.deployments[11].section in data.sectionIds) &&
          (data.deployments.size() <= 12 || data.deployments[12].section in data.sectionIds) &&
          (data.deployments.size() <= 13 || data.deployments[13].section in data.sectionIds) &&
          (data.deployments.size() <= 14 || data.deployments[14].section in data.sectionIds) &&
          (data.deployments.size() <= 15 || data.deployments[15].section in data.sectionIds) &&
          (data.deployments.size() <= 16 || data.deployments[16].section in data.sectionIds) &&
          (data.deployments.size() <= 17 || data.deployments[17].section in data.sectionIds) &&
          (data.deployments.size() <= 18 || data.deployments[18].section in data.sectionIds) &&
          (data.deployments.size() <= 19 || data.deployments[19].section in data.sectionIds) &&
          (isAdmin() || (data.ownerUid == request.auth.uid && data.sectionIds.hasOnly(teacherSections())));
      }
      allow get, list: if isAdmin() || (isTeacher() &&
        (resource.data.get("ownerUid","") == request.auth.uid || resource.data.get("sectionIds",[]).hasAny(teacherSections()))) ||
        mayReadStudentAssessment(resource.data);
      allow create: if isInstructor() && validAssessment(request.resource.data);
      allow update: if isInstructor() && validAssessment(request.resource.data) &&
        (isAdmin() || (resource.data.get("ownerUid","") == request.auth.uid && request.resource.data.ownerUid == resource.data.ownerUid)) &&
        request.resource.data.get("schemaVersion",1) == resource.data.get("schemaVersion",1);
      allow delete: if isInstructor() && resource.data.get("schemaVersion",1) != 2 &&
        (isAdmin() || resource.data.get("ownerUid","") == request.auth.uid);
    }
    match /assessment_private/{assessmentId} {
      allow get: if mayTeachAssessment(assessmentId);
      allow list: if isAdmin() || (isTeacher() &&
        (resource.data.get("ownerUid","") == request.auth.uid || resource.data.get("sectionIds",[]).hasAny(teacherSections())));
      allow create, update: if isAdmin() || (isTeacher() &&
        getAfter(/databases/$(database)/documents/assessments/$(assessmentId)).data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid && request.resource.data.sectionIds == getAfter(/databases/$(database)/documents/assessments/$(assessmentId)).data.sectionIds);
      allow delete: if isAdmin();
    }
    match /grades/{gradeId} {
      allow read: if mayTeachSection(resource.data.section);
      allow create, update: if mayTeachStudent(request.resource.data.studentId) &&
        request.resource.data.section == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        (isAdmin() || (!exists(/databases/$(database)/documents/grades/$(gradeId)) ||
          (resource.data.studentId == request.resource.data.studentId && resource.data.section == request.resource.data.section)));
      allow delete: if isAdmin();
    }
    match /activity_grades/{gradeId} {
      function validActivityGrade(data) {
        return data.keys().hasOnly(["studentId","section","githubUsername","activity","score","maxScore","gradedAt","taskId","feedback","published","gradeVersion","reviewedBy","reviewNote","updatedAt"]) &&
          data.studentId is string && data.section is string &&
          data.section == get(/databases/$(database)/documents/students/$(data.studentId)).data.section &&
          data.activity is string && data.activity.size() > 0 && data.activity.size() <= 300 &&
          data.get("githubUsername","") is string && data.get("githubUsername","").size() <= 200 &&
          data.score is number && data.maxScore is number && data.maxScore > 0 && data.maxScore <= 1000 &&
          data.score >= 0 && data.score <= data.maxScore && data.gradedAt is string && data.gradedAt.size() <= 64 &&
          data.get("feedback","") is string && data.get("feedback","").size() <= 6000 && data.get("published",false) is bool &&
          data.get("taskId","") is string && data.get("taskId","").size() <= 200 &&
          data.get("reviewNote","") is string && data.get("reviewNote","").size() <= 3000 &&
          (!("gradeVersion" in data) || (data.gradeVersion is int && data.gradeVersion > 0 && data.reviewedBy == request.auth.uid && data.updatedAt == request.time));
      }
      function validActivityRevision(data) {
        let version = data.get("gradeVersion",0);
        let audit = version == 0 ? {} : getAfter(/databases/$(database)/documents/activity_grades/$(gradeId)/versions/$(string(version))).data;
        return version == 0 || (audit.after == data && audit.actorUid == request.auth.uid && audit.createdAt == request.time &&
          version == (resource == null ? 1 : resource.data.get("gradeVersion",0) + 1));
      }
      allow read: if mayTeachSection(resource.data.section);
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId) && resource.data.get("published",false) == true;
      allow create: if mayTeachStudent(request.resource.data.studentId) && validActivityGrade(request.resource.data) && validActivityRevision(request.resource.data);
      allow update: if mayTeachStudent(resource.data.studentId) && request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.section == resource.data.section && validActivityGrade(request.resource.data) && validActivityRevision(request.resource.data) &&
        (resource.data.get("published",false) == false || (request.resource.data.published == false && request.resource.data.score == resource.data.score && request.resource.data.feedback == resource.data.feedback));
      allow delete: if isAdmin();
      match /versions/{version} {
        allow read: if mayTeachSection(resource.data.after.section);
        allow create: if request.resource.data.keys().hasOnly(["before","after","actorUid","createdAt"]) &&
          mayTeachStudent(request.resource.data.after.studentId) && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/activity_grades/$(gradeId)).data &&
          version == string(request.resource.data.after.gradeVersion) &&
          request.resource.data.before == (exists(/databases/$(database)/documents/activity_grades/$(gradeId)) ? get(/databases/$(database)/documents/activity_grades/$(gradeId)).data : null);
        allow update, delete: if false;
      }
    }

    match /playground_snapshots/{snapshotId} {
      // New snapshots are private unless explicitly shared by link.
      // Legacy public-by-link records remain compatible until migration.
      allow read: if signedIn() &&
        (resource.data.get("visibility","legacy") == "legacy" ||
         resource.data.get("visibility","") == "link" ||
         resource.data.get("ownerUid","") == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.visibility in ["private","link"] &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list;
      allow update, delete: if false;
    }

    // Recoverable cloud code is visible only to the authenticated owner.
    // Version contents stay immutable; owners may rename metadata or explicitly delete a version.
    match /student_playground_workspaces/{uid}/versions/{versionId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.ownerUid == uid &&
        request.resource.data.files is map &&
        request.resource.data.fileOrder is list &&
        request.resource.data.lang in ["java","python","web","csharp","cpp","dart"];
      allow update: if signedIn() && request.auth.uid == uid &&
        resource.data.ownerUid == uid && request.resource.data.ownerUid == uid && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["label","renamedAt"]) &&
           request.resource.data.label is string &&
           request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 80 &&
           request.resource.data.renamedAt == request.time) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pinned","pinChangedAt"]) &&
           request.resource.data.pinned is bool &&
           request.resource.data.pinChangedAt == request.time)
        );
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.ownerUid == uid;
    }

    // Reports are private to their reporter and selected staff audience.
    // Bug reports are ALWAYS admin-only (plus reporter access to My reports).
    // Missing audience on legacy records means admin until migrated.
    match /issues/{issueId} {
      allow read: if mayReadIssue(resource.data);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "title", "description", "category", "priority", "images",
          "urlContext", "reporterEmail", "reporterUid", "reporterRole",
          "status", "upvotes", "locked", "createdAt",
          "module", "expectedBehavior", "actualBehavior", "reproductionSteps",
          "clientContext", "audience", "studentId", "section"
        ]) &&
        request.resource.data.audience in ["teacher", "admin"] &&
        (request.resource.data.audience == "admin" ||
          (ownsStudentProfile(request.resource.data.get("studentId","")) &&
           request.resource.data.section == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section)) &&
        (request.resource.data.category != "Bug" ||
         request.resource.data.audience == "admin") &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reporterEmail is string &&
        (request.resource.data.reporterEmail == "" ||
         request.resource.data.reporterEmail.lower() == request.auth.token.email.lower()) &&
        request.resource.data.reporterRole == "reporter" &&
        request.resource.data.category in ["Bug", "Access", "Feature", "UI", "Other"] &&
        request.resource.data.priority in ["Low", "Medium", "High", "Critical"] &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 4 &&
        request.resource.data.title.size() <= 160 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() >= 5 &&
        request.resource.data.description.size() <= 6000 &&
        request.resource.data.images is list &&
        request.resource.data.images.size() <= 5 &&
        request.resource.data.status == "Open" &&
        request.resource.data.locked == false &&
        request.resource.data.upvotes.size() == 0 &&
        request.resource.data.createdAt == request.time;
      // New votes use Firebase UID; legacy email votes can still be removed.
      // Only adding/removing the authenticated user's single vote is allowed.
      allow update: if (isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","priority","locked","internalTest","updatedAt"]) &&
        request.resource.data.get("internalTest",false) is bool &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"]) || request.resource.data.updatedAt == request.time)) ||
        (isTeacher() &&
        resource.data.get("audience", "admin") == "teacher" &&
        mayTeachSection(resource.data.get("section",null)) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "priority", "locked", "updatedAt"]) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["updatedAt"]) ||
          request.resource.data.updatedAt == request.time
        )) ||
        (mayReadIssue(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["upvotes"]) &&
        request.resource.data.upvotes is list &&
        request.resource.data.upvotes.size() <= 500 &&
        (
          (
            !(request.auth.uid in resource.data.upvotes) &&
            request.auth.uid in request.resource.data.upvotes &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() + 1 &&
            request.resource.data.upvotes.hasAll(resource.data.upvotes)
          ) ||
          (
            request.auth.uid in resource.data.upvotes &&
            !(request.auth.uid in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          ) ||
          (
            request.auth.token.email.lower() in resource.data.upvotes &&
            !(request.auth.token.email.lower() in request.resource.data.upvotes) &&
            request.resource.data.upvotes.size() == resource.data.upvotes.size() - 1 &&
            resource.data.upvotes.hasAll(request.resource.data.upvotes)
          )
        ));
      allow delete: if false;
      match /comments/{commentId} {
        allow read: if mayReadIssueById(issueId);
        allow create: if mayReadIssueById(issueId) &&
          request.resource.data.keys().hasOnly([
            "text", "authorEmail", "authorUid", "role", "createdAt"
          ]) &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorEmail is string &&
          (request.resource.data.authorEmail == "" ||
           request.resource.data.authorEmail.lower() == request.auth.token.email.lower()) &&
          request.resource.data.role == (isAdmin() ? "superadmin" : isTeacher() ? "teacher" : "student") &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          get(/databases/$(database)/documents/issues/$(issueId)).data.locked == false;
        allow update: if false;
        allow delete: if mayReadIssueById(issueId) &&
          (resource.data.get("authorUid", null) == request.auth.uid ||
           (resource.data.get("authorEmail", "") is string &&
            resource.data.authorEmail != "" &&
            resource.data.authorEmail.lower() == request.auth.token.email.lower()));
      }
    }

    // Official notifications are created only by Firebase Admin SDK triggers.
    // Recipients may mark their own notification as read, not forge an alert.
    match /notifications/{uid}/items/{notificationId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]) &&
        request.resource.data.readAt == request.time;
      allow create, delete: if false;
    }

    match /push_preferences/{uid} {
      function validPushPreferences() {
        let data=request.resource.data;
        return data.keys().hasOnly(["ownerUid","enabled","assessment","submission","grade","grading","issue","release","updatedAt"]) &&
          data.keys().hasAll(["ownerUid","enabled","assessment","submission","grade","updatedAt"]) &&
          data.ownerUid == uid && data.enabled is bool && data.assessment is bool &&
          data.submission is bool && data.grade is bool &&
          data.get("grading",true) is bool && data.get("issue",true) is bool && data.get("release",true) is bool &&
          data.updatedAt == request.time;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && validPushPreferences();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /push_devices/{deviceId} {
      function validPushDevice() {
        let data=request.resource.data;
        return deviceId.matches("^[a-f0-9]{40}$") &&
          data.keys().hasOnly(["ownerUid","token","enabled","platform","userAgent","updatedAt"]) &&
          data.keys().hasAll(["ownerUid","token","enabled","platform","userAgent","updatedAt"]) &&
          data.ownerUid == request.auth.uid && data.token is string && data.token.size() > 20 &&
          data.token.size() <= 4096 && data.enabled is bool &&
          data.platform is string && data.platform.size() <= 80 &&
          data.userAgent is string && data.userAgent.size() <= 500 &&
          data.updatedAt == request.time;
      }
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && validPushDevice();
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == resource.data.ownerUid && validPushDevice();
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function practiceMissionIds(courseId) {
      return courseId == "java" ? ["j1","java-m1-02","java-m1-03","java-m1-04","java-m1-05","java-m1-06","java-m1-07","java-m1-08","java-m1-09","java-m1-10","java-m1-11","java-m1-12","java-m1-13","java-m1-14","java-m1-15","j2","java-m2-02","java-m2-03","java-m2-04","java-m2-05","java-m2-06","java-m2-07","java-m2-08","java-m2-09","java-m2-10","java-m2-11","java-m2-12","java-m2-13","java-m2-14","java-m2-15","j3","java-m3-02","java-m3-03","java-m3-04","java-m3-05","java-m3-06","java-m3-07","java-m3-08","java-m3-09","java-m3-10","java-m3-11","java-m3-12","java-m3-13","java-m3-14","java-m3-15","j4","java-m4-02","java-m4-03","java-m4-04","java-m4-05","java-m4-06","java-m4-07","java-m4-08","java-m4-09","java-m4-10","java-m4-11","java-m4-12","java-m4-13","java-m4-14","java-m4-15","java-m5-01","java-m5-02","java-m5-03","java-m5-04","java-m5-05","java-m5-06","java-m5-07","java-m5-08","java-m5-09","java-m5-10","java-m5-11","java-m5-12","java-m5-13","java-m5-14","java-m5-15"] :
        courseId == "python" ? ["p1","python-m1-02","python-m1-03","python-m1-04","python-m1-05","python-m1-06","python-m1-07","python-m1-08","python-m1-09","python-m1-10","python-m1-11","python-m1-12","python-m1-13","python-m1-14","python-m1-15","p2","python-m2-02","python-m2-03","python-m2-04","python-m2-05","python-m2-06","python-m2-07","python-m2-08","python-m2-09","python-m2-10","python-m2-11","python-m2-12","python-m2-13","python-m2-14","python-m2-15","p3","python-m3-02","python-m3-03","python-m3-04","python-m3-05","python-m3-06","python-m3-07","python-m3-08","python-m3-09","python-m3-10","python-m3-11","python-m3-12","python-m3-13","python-m3-14","python-m3-15","p4","python-m4-02","python-m4-03","python-m4-04","python-m4-05","python-m4-06","python-m4-07","python-m4-08","python-m4-09","python-m4-10","python-m4-11","python-m4-12","python-m4-13","python-m4-14","python-m4-15","python-m5-01","python-m5-02","python-m5-03","python-m5-04","python-m5-05","python-m5-06","python-m5-07","python-m5-08","python-m5-09","python-m5-10","python-m5-11","python-m5-12","python-m5-13","python-m5-14","python-m5-15"] :
        courseId == "web" ? ["w1","web-m1-02","web-m1-03","web-m1-04","web-m1-05","web-m1-06","web-m1-07","web-m1-08","web-m1-09","web-m1-10","web-m1-11","web-m1-12","web-m1-13","web-m1-14","web-m1-15","w2","web-m2-02","web-m2-03","web-m2-04","web-m2-05","web-m2-06","web-m2-07","web-m2-08","web-m2-09","web-m2-10","web-m2-11","web-m2-12","web-m2-13","web-m2-14","web-m2-15","w3","web-m3-02","web-m3-03","web-m3-04","web-m3-05","web-m3-06","web-m3-07","web-m3-08","web-m3-09","web-m3-10","web-m3-11","web-m3-12","web-m3-13","web-m3-14","web-m3-15","w4","web-m4-02","web-m4-03","web-m4-04","web-m4-05","web-m4-06","web-m4-07","web-m4-08","web-m4-09","web-m4-10","web-m4-11","web-m4-12","web-m4-13","web-m4-14","web-m4-15","web-m5-01","web-m5-02","web-m5-03","web-m5-04","web-m5-05","web-m5-06","web-m5-07","web-m5-08","web-m5-09","web-m5-10","web-m5-11","web-m5-12","web-m5-13","web-m5-14","web-m5-15"] :
        courseId == "logic" ? ["d1","logic-m1-02","logic-m1-03","logic-m1-04","logic-m1-05","logic-m1-06","logic-m1-07","logic-m1-08","logic-m1-09","logic-m1-10","logic-m1-11","logic-m1-12","logic-m1-13","logic-m1-14","logic-m1-15","d3","logic-m2-02","logic-m2-03","logic-m2-04","logic-m2-05","logic-m2-06","logic-m2-07","logic-m2-08","logic-m2-09","logic-m2-10","logic-m2-11","logic-m2-12","logic-m2-13","logic-m2-14","logic-m2-15","d2","logic-m3-02","logic-m3-03","logic-m3-04","logic-m3-05","logic-m3-06","logic-m3-07","logic-m3-08","logic-m3-09","logic-m3-10","logic-m3-11","logic-m3-12","logic-m3-13","logic-m3-14","logic-m3-15","logic-m4-01","logic-m4-02","logic-m4-03","logic-m4-04","logic-m4-05","logic-m4-06","logic-m4-07","logic-m4-08","logic-m4-09","logic-m4-10","logic-m4-11","logic-m4-12","logic-m4-13","logic-m4-14","logic-m4-15","d4","logic-m5-02","logic-m5-03","logic-m5-04","logic-m5-05","logic-m5-06","logic-m5-07","logic-m5-08","logic-m5-09","logic-m5-10","logic-m5-11","logic-m5-12","logic-m5-13","logic-m5-14","logic-m5-15"] :
        [];
    }
    function canReadPracticeClass(section) {
      let profile = get(/databases/$(database)/documents/practice_profiles/$(request.auth.uid)).data;
      return profile.ownerUid == request.auth.uid && profile.section == section && ownsStudentProfile(profile.studentId) &&
        profile.section == get(/databases/$(database)/documents/students/$(profile.studentId)).data.section;
    }
    match /practice_rankings/{studentId} {
      allow read: if mayTeachSection(resource.data.section) || (signedIn() && request.auth.token.email_verified == true &&
        (ownsStudentProfile(studentId) || canReadPracticeClass(resource.data.section)));
      allow write: if false;
    }
    match /practice_verified_progress/{uid}/courses/{courseId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    match /practice_class_progress/{studentId}/courses/{courseId} {
      allow read: if mayTeachStudent(studentId) || ownsStudentProfile(studentId);
      allow write: if false;
    }
    match /practice_awards/{uid}/missions/{missionId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }
    match /practice_sessions/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /practice_browser_sessions/{browserId} { allow read: if isAdmin(); allow write: if false; }
    match /practice_attempts/{attemptId} { allow read: if isAdmin(); allow write: if false; }
    match /practice_security_events/{eventId} { allow read: if isAdmin(); allow write: if false; }
    // Formative student practice, separate from official assessments/grades.
    // Teachers may inspect progress through the existing instructor privileges.
    match /practice_profiles/{uid} {
      function validPracticeProfile() {
        let data = request.resource.data;
        return data.keys().hasOnly(["ownerUid","studentId","section","alias","leaderboardOptIn","updatedAt"]) &&
          data.ownerUid == uid && data.studentId is string && ownsStudentProfile(data.studentId) &&
          data.section == get(/databases/$(database)/documents/students/$(data.studentId)).data.section &&
          data.alias is string && data.alias.matches("^[A-Za-z0-9_ -]{3,24}$") &&
          data.leaderboardOptIn is bool && data.updatedAt == request.time;
      }
      allow read: if mayTeachSection(resource.data.section) || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid && validPracticeProfile();
      allow delete: if false;
    }
    match /practice_scores/{studentId} {
      allow get: if mayTeachStudent(studentId);
      function validPracticeScore() {
        let data = request.resource.data;
        let revision = exists(/databases/$(database)/documents/practice_scores/$(studentId)) ? resource.data.revision + 1 : 1;
        let audit = getAfter(/databases/$(database)/documents/practice_scores/$(studentId)/revisions/$(string(revision))).data;
        return data.keys().hasOnly(["studentId","section","verifiedMissionIds","points","reviewedBy","reviewNote","revision","updatedAt"]) &&
          data.studentId == studentId && data.section == get(/databases/$(database)/documents/students/$(studentId)).data.section &&
          data.verifiedMissionIds is list && data.verifiedMissionIds.size() <= 300 &&
          data.verifiedMissionIds.toSet().size() == data.verifiedMissionIds.size() &&
          data.verifiedMissionIds.hasOnly(practiceMissionIds("java").concat(practiceMissionIds("python")).concat(practiceMissionIds("web")).concat(practiceMissionIds("logic"))) &&
          data.points == data.verifiedMissionIds.size() * 10 && data.reviewedBy == request.auth.uid &&
          data.reviewNote is string && data.reviewNote.size() >= 15 && data.reviewNote.size() <= 3000 &&
          data.revision == revision && data.updatedAt == request.time && audit.after == data;
      }
      allow read: if mayTeachSection(resource.data.section) || ownsStudentProfile(studentId);
      allow create, update: if mayTeachStudent(studentId) && validPracticeScore();
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if mayTeachStudent(studentId) || ownsStudentProfile(studentId);
        allow create: if mayTeachStudent(studentId) && request.resource.data.keys().hasOnly(["before","after","actorUid","createdAt"]) &&
          request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time &&
          request.resource.data.before == (exists(/databases/$(database)/documents/practice_scores/$(studentId)) ? get(/databases/$(database)/documents/practice_scores/$(studentId)).data : null) &&
          request.resource.data.after == getAfter(/databases/$(database)/documents/practice_scores/$(studentId)).data &&
          revisionId == string(request.resource.data.after.revision) &&
          request.resource.data.after.revision == (request.resource.data.before == null ? 1 : request.resource.data.before.revision + 1);
        allow update, delete: if false;
      }
    }
    match /practice_boards/{studentId} {
      allow read: if mayTeachSection(resource.data.section) || ownsStudentProfile(studentId);
      allow create, update: if mayTeachStudent(studentId) && request.resource.data.keys().hasOnly(["section","rows","publishedBy","publishedAt"]) &&
        request.resource.data.section == get(/databases/$(database)/documents/students/$(studentId)).data.section &&
        request.resource.data.rows is list && request.resource.data.rows.size() <= 200 &&
        request.resource.data.publishedBy == request.auth.uid && request.resource.data.publishedAt == request.time;
      allow delete: if mayTeachStudent(studentId);
    }
    match /student_practice_progress/{uid}/courses/{courseId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if false;
    }

    match /notification_history/{uid}/items/{notificationId} {
      function validHistory() {
        return request.resource.data.keys().hasOnly([
            "ownerUid", "sourceKey", "type", "title", "body", "target",
            "at", "savedForLater", "openedAt", "lastInteractedAt",
            "reportCategory", "reportAudience"
          ]) &&
          request.resource.data.keys().hasAll([
            "ownerUid", "sourceKey", "type", "title", "body", "target",
            "at", "savedForLater", "openedAt", "lastInteractedAt"
          ]) &&
          request.resource.data.ownerUid == uid &&
          request.resource.data.sourceKey is string &&
          request.resource.data.sourceKey.size() <= 500 &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 240 &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 800 &&
          request.resource.data.type is string &&
          request.resource.data.type.size() <= 32 &&
          request.resource.data.target is string &&
          request.resource.data.target.size() <= 220 &&
          request.resource.data.at is number &&
          request.resource.data.savedForLater is bool &&
          request.resource.data.openedAt == request.time &&
          request.resource.data.lastInteractedAt == request.time;
      }
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validHistory();
      allow update: if signedIn() && request.auth.uid == uid &&
        resource.data.ownerUid == uid &&
        resource.data.sourceKey == request.resource.data.sourceKey &&
        validHistory();
      allow delete: if false;
    }

    // Only instructors may read or write internal grading-failure diagnostics.
    match /grading_alerts/{alertId} {
      allow read: if mayTeachSection(resource.data.section);
      allow create, update: if mayTeachStudent(request.resource.data.studentId) && request.resource.data.section == get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section;
      allow delete: if isAdmin();
    }

    // Student-initiated submission receipts are immutable, reviewable evidence.
    match /student_submissions/{submissionId} {
      allow read: if mayTeachSection(resource.data.section);
      allow read: if signedIn() && ownsStudentProfile(resource.data.studentId);
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          "studentId", "assessmentId", "submittedByUid",
          "studentName", "assessmentTitle", "repoUrl", "githubLogin",
          "revisionSha", "sourcePath", "submittedAt", "section"
        ]) &&
        request.resource.data.submittedByUid == request.auth.uid &&
        ownsStudentProfile(request.resource.data.studentId) &&
        request.resource.data.studentId is string &&
        request.resource.data.assessmentId is string &&
        exists(/databases/$(database)/documents/assessments/$(request.resource.data.assessmentId)) &&
        request.resource.data.section is string &&
        request.resource.data.section ==
          get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.section &&
        request.resource.data.sourcePath is string &&
        request.resource.data.sourcePath.size() <= 240 &&
        request.resource.data.repoUrl is string &&
        request.resource.data.repoUrl.matches("^https://github[.]com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$") &&
        request.resource.data.revisionSha is string &&
        request.resource.data.revisionSha.matches("^[a-fA-F0-9]{40}$") &&
        request.resource.data.submittedAt == request.time;
      allow update, delete: if false;
    }
  }
}
