# Copy to ~/.config/adminerva-runtime/runtime.env (chmod 600).
# Values below are non-secret. A Firebase Admin private key is NOT required.
ALLOWED_ORIGIN=https://adminerva-org.github.io
FIREBASE_PROJECT_ID=reporeview-e7ca4
PORT=8787
DOCKER_IMAGE=adminerva/java17-runner:pilot
MAX_ACTIVE_SESSIONS=8
MAX_PENDING_SESSIONS=200
IDLE_SESSION_SECONDS=300
MAX_SESSION_SECONDS=900
DISCONNECT_GRACE_SECONDS=120
